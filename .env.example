# GEMINI_API_KEY: Required for remote AI synthesis and inquiry generation (gemini-3.5-flash).
# In Google AI Studio and Cloud Run, this is provided securely via Secret Manager.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL: The Google Gemini model used for editorial synthesis (defaults to gemini-3.5-flash).
GEMINI_MODEL="gemini-3.5-flash"

# APP_URL: The base URL where DocuLens is hosted.
# Used for self-referential links, PWA scope, and client-server communication.
APP_URL="http://localhost:3000"

# PORT: The port the Express/Node server listens on (Cloud Run defaults to 8080, local defaults to 3000).
PORT=3000
